menu "Heapwatch Connector"

    # Stream ingress is mandatory
    config HEAPWATCH_ENABLE_STREAM_INGRESS
        bool
        default y

    choice HEAPWATCH_BUILD_ENV_CHOICE
        prompt "Build Environment"
        default HEAPWATCH_BUILD_ENV_DEVELOPMENT
        help
            Reporting label sent when the device enrolls. Does not change which
            servers the device connects to.

        config HEAPWATCH_BUILD_ENV_DEVELOPMENT
            bool "development"

        config HEAPWATCH_BUILD_ENV_TESTING
            bool "testing"

        config HEAPWATCH_BUILD_ENV_STAGING
            bool "staging"

        config HEAPWATCH_BUILD_ENV_PRODUCTION
            bool "production"
    endchoice

    config HEAPWATCH_BUILD_ENV
        string
        default "development" if HEAPWATCH_BUILD_ENV_DEVELOPMENT
        default "testing" if HEAPWATCH_BUILD_ENV_TESTING
        default "staging" if HEAPWATCH_BUILD_ENV_STAGING
        default "production"

    menu "Wi-Fi"
        config HEAPWATCH_MANAGE_WIFI
            bool "Auto-Manage Wi-Fi Connection"
            default y
            help
                y: the connector brings up Wi-Fi itself using the SSID/password below.
                n: the connector does not touch networking at all — your application brings
                up its own netif (Wi-Fi, Ethernet, cellular modem, ...) on its own
                schedule and Heapwatch connector picks it up

        config HEAPWATCH_WIFI_SSID
            string "SSID"
            default ""
            depends on HEAPWATCH_MANAGE_WIFI

        config HEAPWATCH_WIFI_PASSWORD
            string "Password"
            default ""
            depends on HEAPWATCH_MANAGE_WIFI
    endmenu

    menu "Time Sync"
        config HEAPWATCH_MANAGE_TIME_SYNC
            bool "Auto-Manage Time Sync"
            default y
            help
                y: the connector automatically manages time sync with the internet so the device gets its time and date
                n: your application manages time sync
    endmenu

    menu "Heapwatch Connection"
        comment "Your device connects to Heapwatch by requesting access credentials from Heapwatch via REST API. For this you need to enter a valid Enrollment Key."
        comment "Get your Enrollment Key from Heapwatch UI / Enrollment page / Enrollment Keys page."

        config HEAPWATCH_ENROLLMENT_KEY
            string "Enrollment Key"
            default ""
            help
                Enrollment key (sk_enroll_…) is a short-lived one-off key to request login credentials
                from Heapwatch. This key is baked into your firmware and expired once enrollment suceeds.

        config HEAPWATCH_ENROLLMENT_POLL_INTERVAL_MS
            int "Enrollment Status Poll Interval (ms)"
            default 60000
            range 5000 300000
            help
                Once your device requests credentials from Heapwatch, it will start to check its "enrollment status". This is the interval in which the device will call Heapwatch to check if its enrollment has been accepted and login credentials ready to be downloaded.

        config HEAPWATCH_ENROLL_STATE_LED_INDICATOR
            bool "Enroll State LED Indicator"
            default n
            help
                Great way to see and debug enrollment status. If you have a spare LED on your board, you can assign
                it to enrollment status and it will blink according the current enrollment state. Blinking table can be
                found in Heapwatch UI / Enrollment Page.

        config HEAPWATCH_ENROLL_STATE_LED_GPIO
            int "Enroll State LED GPIO Pin"
            default -1
            range -1 48
            depends on HEAPWATCH_ENROLL_STATE_LED_INDICATOR
            help
                GPIO number for the status LED. Must be wired on the board.
                -1 means unset (indicator stays off even if enabled).

        config HEAPWATCH_ENROLL_STATE_LED_ACTIVE_LOW
            bool "Enroll State LED Active Low"
            default y
            depends on HEAPWATCH_ENROLL_STATE_LED_INDICATOR
            help
                y: LED turns on when GPIO is driven low (common on dev boards).
                n: LED turns on when GPIO is driven high.
    endmenu

    menu "Features"
        config HEAPWATCH_ENABLE_LOG_COLLECTION
            bool "Collect ESP-IDF Logs"
            default y
            help
                Collects ESP-IDF log messages. Disabling excludes the
                log-capture/relay pipeline from the build entirely.

        choice HEAPWATCH_MIN_LOG_SEVERITY
            prompt "Minimum Log Severity"
            default HEAPWATCH_MIN_LOG_SEVERITY_INFO
            depends on HEAPWATCH_ENABLE_LOG_COLLECTION
            help
                Logs at this level or higher are dispatched to Heapwatch. Logs below this level are still printed locally (serial) but are not
                queued for remote delivery.

            config HEAPWATCH_MIN_LOG_SEVERITY_DEBUG
                bool "Debug"
                imply LOG_DEFAULT_LEVEL_DEBUG
            config HEAPWATCH_MIN_LOG_SEVERITY_INFO
                bool "Info"
            config HEAPWATCH_MIN_LOG_SEVERITY_WARNING
                bool "Warning"
            config HEAPWATCH_MIN_LOG_SEVERITY_ERROR
                bool "Error"
            config HEAPWATCH_MIN_LOG_SEVERITY_CRITICAL
                bool "Critical"
        endchoice

        config HEAPWATCH_ENABLE_TASK_SNAPSHOTS
            bool "Collect FreeRTOS Task Snapshots"
            default y
            help
                Collects tasks CPU usage and stack used and total memory. A must for stack overflow prevention.

        config HEAPWATCH_ENABLE_CPU_SNAPSHOTS
            bool "Collect Per-Core CPU Usage"
            default y
            help
                Collects per-core CPU usage.

        config HEAPWATCH_NEEDS_FREERTOS_RUNTIME_STATS
            bool
            default y if HEAPWATCH_ENABLE_TASK_SNAPSHOTS || HEAPWATCH_ENABLE_CPU_SNAPSHOTS
            select FREERTOS_USE_TRACE_FACILITY
            select FREERTOS_GENERATE_RUN_TIME_STATS
            select FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER
            select FREERTOS_RUN_TIME_COUNTER_TYPE_U32

        config HEAPWATCH_ENABLE_HEAP_SNAPSHOTS
            bool "Collect RAM Usage"
            default y
            help
                Collects internal RAM and external PSRAM usages and largest free block intel
                for fantastic memory and heap fragmentation intelligence.

        config HEAPWATCH_ENABLE_NETIF_TRAFFIC
            bool "Collect Network Interface Bytes Transmitted/Received"
            default y
            select LWIP_STATS
            help
                Collects number of bytes received and transmitted for each available
                network interface like WiFi, modem, ethernet etc.

        config HEAPWATCH_ENABLE_OTA
            bool "Enable Heapwatch OTA"
            default y
            select BOOTLOADER_APP_ROLLBACK_ENABLE
            help
                Enable Heapwatch OTA (MQTT ota/* + HTTPS flash) from the Heapwatch UI or MCP.

                Automatically enables CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE so a newly
                flashed app boots in ESP_OTA_IMG_PENDING_VERIFY until confirmed via the
                ota/confirm device command (esp_ota_mark_app_valid_cancel_rollback).
                Reboot without confirm rolls back to the previous slot.

                Requires a dual-OTA partition table (two app slots + otadata).

        choice HEAPWATCH_OTA_DOWNLOAD_CHUNK_BYTES
            prompt "OTA HTTPS Download Chunk Size"
            default HEAPWATCH_OTA_DOWNLOAD_CHUNK_4096
            depends on HEAPWATCH_ENABLE_OTA
            help
                Buffer size in BSS RAM space (not stack) used to download firmware over HTTPS
                and write it right away into unused OTA partition. Keep 4K buffer unless you have a reason
                to change this.

            config HEAPWATCH_OTA_DOWNLOAD_CHUNK_256
                bool "256 bytes (tiny RAM, slow OTA, NOT recommended)"

            config HEAPWATCH_OTA_DOWNLOAD_CHUNK_4096
                bool "4096 bytes (recommended, fast OTA)"
        endchoice

        config HEAPWATCH_OTA_DOWNLOAD_CHUNK_BYTES
            int
            depends on HEAPWATCH_ENABLE_OTA
            default 256 if HEAPWATCH_OTA_DOWNLOAD_CHUNK_256
            default 4096 if HEAPWATCH_OTA_DOWNLOAD_CHUNK_4096

        config HEAPWATCH_ENABLE_COREDUMP_UPLOAD
            bool "Collect Core Dumps"
            default y
            select ESP_COREDUMP_ENABLE_TO_FLASH
            select ESP_COREDUMP_DATA_FORMAT_ELF
            select ESP_COREDUMP_CHECKSUM_CRC32
            select ESP_COREDUMP_CHECK_BOOT
            help
                Automatically checks for a core dump present in the flash on each boot
                and uploads it to Heapwatch for fantastic crash analytics. A coredump
                partition is REQUIRED in partitions.csv for this to work!

        config HEAPWATCH_ENABLE_STANDARD_EVENTS
            bool "Collect Events"
            default y
            help
                Collects few dozen lifecycle events like starting up, started up, mqtt connected/disconnected,
                internet up/down, etc.

        config HEAPWATCH_ENABLE_HEAP_INTEGRITY_CHECK
            bool "Proactive Heap Integrity Check (Heavy Load)"
            default n
            help
                Periodically calls heap_caps_check_integrity() and dispatches a
                HEAPWATCH_EVENT_HEAP_CORRUPTION_DETECTED event if corruption is found. This
                catches corruption before it causes a crash, instead of only finding out
                post-hoc via coredump. Default off: walking the full heap has a heavy CPU load.

        menu "Filesystem Volumes"
            config HEAPWATCH_AUTO_MOUNT_STORAGE_PARTITIONS
                bool "Auto-Mount All Storage Partitions"
                default y
                help
                    At heapwatch_initialize(), the connector automatically mounts all "storage" partitions
                    in the partition table. If your application mounts your partitions, you should DISABLE this
                    option and register each your partition and its mountpoint via heapwatch_register_fs_volume().

            config HEAPWATCH_AUTO_FORMAT_BLANK_STORAGE_PARTITIONS
                bool "Auto-Format Blank Storage Partitions"
                default y
                depends on HEAPWATCH_AUTO_MOUNT_STORAGE_PARTITIONS
                help
                    When the connector performs a mount, pass format_if_mount_failed to
                    SPIFFS, LittleFS, and FatFS. Only applies to connector-owned mounts, not
                    to partitions the host already mounted.

            config HEAPWATCH_ENABLE_SD_CARD_STATS
                bool "Also Mount And Take-Over SD Card Over SPI"
                default n
                help
                    Only for hosts that do NOT use the SD card themselves: the connector
                    takes over the bus, calling spi_bus_initialize() and mounting a
                    FAT-formatted card at /sd with the pins below. If no card is present or
                    the mount fails, this is logged and skipped -- never fatal, never
                    retried. Once mounted it becomes a normal volume in the file browser.

                    Leave this off when the host firmware already owns the SPI bus or has
                    already mounted the card -- a second bus init will fight the host.
                    Call heapwatch_register_sd_volume(label, mount_path) instead: the
                    connector then only reads used/free and never touches the bus.

            config HEAPWATCH_SD_CARD_CS_GPIO
                int "SD card CS (chip select) GPIO"
                default -1
                range -1 48
                depends on HEAPWATCH_ENABLE_SD_CARD_STATS
                help
                    -1 disables the SD card mount attempt even if the toggle above is on --
                    set to a real GPIO once wired to actual SD card hardware.

            config HEAPWATCH_SD_CARD_MOSI_GPIO
                int "SD card MOSI GPIO"
                default -1
                range -1 48
                depends on HEAPWATCH_ENABLE_SD_CARD_STATS

            config HEAPWATCH_SD_CARD_MISO_GPIO
                int "SD card MISO GPIO"
                default -1
                range -1 48
                depends on HEAPWATCH_ENABLE_SD_CARD_STATS

            config HEAPWATCH_SD_CARD_SCK_GPIO
                int "SD card SCK GPIO"
                default -1
                range -1 48
                depends on HEAPWATCH_ENABLE_SD_CARD_STATS
        endmenu

        # Collect Bluetooth Stats — menu hidden until implementation is ready.
        # menu "Collect Bluetooth Stats"
        #     config HEAPWATCH_ENABLE_BLE_REPORTING
        #         bool "Enable BLE radio reporting (NimBLE report-only)"
        #         default n
        #         help
        #             When enabled, initializes the ESP-IDF NimBLE host in report-only mode
        #             (no advertising) and publishes /bluetooth MQTT snapshots. Requires
        #             CONFIG_BT_ENABLED in the IDF Bluetooth menu.
        #
        #     config HEAPWATCH_BLE_TELEMETRY_ENABLED
        #         bool "Periodic BLE snapshot telemetry"
        #         default y
        #         depends on HEAPWATCH_ENABLE_BLE_REPORTING
        #
        #     config HEAPWATCH_BLE_TELEMETRY_INTERVAL_SEC
        #         int "BLE telemetry interval (seconds)"
        #         default 30
        #         range 5 3600
        #         depends on HEAPWATCH_BLE_TELEMETRY_ENABLED
        #
        #     config HEAPWATCH_BLE_TELEMETRY_ON_CHANGE
        #         bool "Only publish BLE telemetry when snapshot changes"
        #         default y
        #         depends on HEAPWATCH_BLE_TELEMETRY_ENABLED
        # endmenu

        # Stubs: keep CONFIG_* symbols defined for #if guards while menu is hidden.
        config HEAPWATCH_ENABLE_BLE_REPORTING
            bool
            default n

        config HEAPWATCH_BLE_TELEMETRY_ENABLED
            bool
            default n

        config HEAPWATCH_BLE_TELEMETRY_INTERVAL_SEC
            int
            default 30

        config HEAPWATCH_BLE_TELEMETRY_ON_CHANGE
            bool
            default y
    endmenu

    menu "Memory / Queue Sizing"
        config HEAPWATCH_MAX_LOG_LINE_LEN
            int "Maximum Log Line Length (bytes)"
            default 160
            range 32 1024
            help
                Log lines longer than this are truncated before being queued for MQTT
                delivery. Lower values reduce worst-case RAM use of the log pipeline.

        config HEAPWATCH_TINY_QUEUE_LEN
            int "Tiny MQTT Queue Depth (PARAMETER/EVENT)"
            default 24
            range 4 10000
            help
                Depth of the tiny-tier queue used for single-value PARAMETER and
                EVENT messages (~96 B per slot).

        config HEAPWATCH_SMALL_QUEUE_LEN
            int "Small MQTT Queue Depth (LOG)"
            default 12
            range 4 10000
            help
                Depth of the small-tier queue used for LOG messages (sized off
                HEAPWATCH_MAX_LOG_LINE_LEN). Independent of the tiny queue so
                log bursts don't starve parameter/event buffering and vice versa.

        config HEAPWATCH_LARGE_QUEUE_LEN
            int "Large MQTT Queue Depth (SPECS/TASKS)"
            default 3
            range 1 10000
            help
                Depth of the large-tier queue used for SPECS/TASKS messages and
                the periodic metrics PARAMETER blob. Increase depth when you have spare
                memory (internal DRAM or PSRAM — see "Allocate MQTT message queues in PSRAM")
                and want to preserve stats during intermittent connection outages like
                having a CatM modem and moving around with the device.

        config HEAPWATCH_ALLOCATE_QUEUES_IN_PSRAM
            bool "Allocate MQTT message queues in PSRAM"
            default n
            depends on SPIRAM
            help
                Places all queue slots in the external
                PSRAM instead of internal RAM.

                Requires SPIRAM enabled and initialized in the project sdkconfig.

                Great for storing lots of pending telemetry during intermittent modem connection disconnects.
                Recommended for modem applications that face constant signal interruptions (moving vehicles etc).

        config HEAPWATCH_METRICS_INTERVAL_MS
            int "Initial Metrics Collection Interval (ms)"
            default 2000
            range 500 60000
            help
                This is the initial interval at which the connector collects and sends out telemetry data.
                Can be changed remotely from Heapwatch UI.

        config HEAPWATCH_TASK_SAMPLE_INTERVAL_MS
            int "Task Stack Sampling Interval (ms)"
            default 500
            range 100 5000
            help
                How often each task's stack statistics are read. Can be changed remotely from Heapwatch UI.

        config HEAPWATCH_LOG_BATCH_MAX
            int "Max Log Lines Per MQTT Publish"
            default 10
            range 1 64
            help
                The connector batches log lines into one bigger MQTT message to increase efficiency.
                Recommended max batch is 10. Make sure that your system MQTT max payload size is big enough
                to store this batch X max log line + some overhead. If you set these numbers bigger than MQTT max
                payload size, log MQTT dispatches to Heapwatch will fail.
    endmenu

endmenu
